# Copy to .env (never commit .env). In production inject these from a secret store.
VASTRA_ENV=dev
LEGACY_DB_PATH=../vastra-legacy-lab/data/vastra_legacy.db
VASTRA_DB_PATH=data/modern.db
PARTNER_BASE_URL=http://127.0.0.1:8100
COURIER_TIMEOUT_S=0.8
PAYMENT_TIMEOUT_S=3.0
FALLBACK_DELIVERY_DAYS=4
PRODUCT_CACHE_SECONDS=60
# Outside dev, set real keys as JSON:  {"<key>": {"client": "web", "user": null, "roles": ["read","checkout"]}}
# VASTRA_API_KEYS=
